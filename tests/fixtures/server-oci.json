{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.vish288/fixture",
  "title": "Fixture",
  "description": "Registry shape fixture (oci without version)",
  "version": "0.0.0",
  "repository": { "url": "https://github.com/vish288/fixture", "source": "github" },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "fixture",
      "version": "0.0.0",
      "runtimeHint": "uvx",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        { "name": "FIXTURE_TOKEN", "description": "token", "isRequired": true, "isSecret": true }
      ]
    },
    {
      "registryType": "oci",
      "identifier": "ghcr.io/vish288/fixture:0.0.0",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        { "name": "FIXTURE_TOKEN", "description": "token", "isRequired": true, "isSecret": true }
      ]
    }
  ]
}
